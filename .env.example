# Copy to .env and fill in. Never commit .env — it's gitignored.
# On Vercel, set these same keys as Environment Variables.

# ─── GreenAPI (WhatsApp) ──────────────────────────────────────────────────
GREENAPI_API_URL=https://7107.api.greenapi.com
GREENAPI_ID_INSTANCE=your_idInstance_here
GREENAPI_TOKEN=your_apiTokenInstance_here

# Delay between sends, ms. Ban-safety — don't lower this.
SEND_DELAY_MS=1500

# Volunteers type local numbers into the Google Form ("91234567"); this
# prefixes them to full international format. Set to "" to require
# fully-qualified numbers instead.
DEFAULT_COUNTRY_CODE=65

# ─── Supabase ──────────────────────────────────────────────────────────────
# Service-role key bypasses Row Level Security — full read/write access to
# every table. Server-side only, never exposed to the client. Treat it like
# a database root password.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Gemini (AI fallback for inbound WhatsApp replies) ─────────────────────
# Used when a reply doesn't match a known keyword (yes/no/stop/start/points):
# classifies it and, for genuine questions, drafts an answer grounded only in
# the event's own fields. Leave blank to disable — replies just get ignored,
# same as before this existed. Free-tier key from aistudio.google.com — no
# card required.
GEMINI_API_KEY=

# Fallback contact number given out when the AI can't answer a question AND
# the event itself has no on-the-day contact set.
DEFAULT_CONTACT_PHONE=

# ─── Google Sheets (volunteer/beneficiary intake) ──────────────────────────
# Published-to-web CSV URLs. Leave blank to read data/volunteers.json instead.
SHEET_CSV_URL=
BENEFICIARY_SHEET_CSV_URL=

# Label the roster groups responses under.
CAMPAIGN=GIFTIK Sunday drive
