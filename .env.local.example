# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set these same keys as Environment Variables.

GREENAPI_API_URL=https://7107.api.greenapi.com
GREENAPI_ID_INSTANCE=710722697368
GREENAPI_TOKEN=your_apiTokenInstance_here

# Delay between sends, ms. Ban-safety — don't lower this.
SEND_DELAY_MS=1500

# Optional. Google Sheet published as CSV (File > Share > Publish to web > CSV).
# Leave blank to read data/volunteers.json instead.
SHEET_CSV_URL=

# Label the roster groups responses under.
CAMPAIGN=GIFTIK Sunday drive
